# Copy to .env and edit
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL
DB_NAME=ita_assessment
DB_USER=ita_user
DB_PASSWORD=ChangeMe@123
DB_HOST=127.0.0.1
DB_PORT=3306

# Email (OTP + score reports). Leave EMAIL_HOST_USER empty to print emails in the terminal (dev mode).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ITA Associates <no-reply@itaassociates.co.uk>

# Email OTP on login (True/False)
OTP_ENABLED=True

# --- Gmail setup (to really send OTP emails) ---
# 1. Google Account > Security > turn ON 2-Step Verification
# 2. Google Account > Security > App passwords > create one (16 letters)
# 3. Put your Gmail in EMAIL_HOST_USER and the 16-letter app password in EMAIL_HOST_PASSWORD (no spaces)
# EMAIL_HOST_USER=yourname@gmail.com
# EMAIL_HOST_PASSWORD=abcdefghijklmnop
# DEFAULT_FROM_EMAIL=ITA Associates <yourname@gmail.com>
